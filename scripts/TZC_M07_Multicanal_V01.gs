}}
function tzcMc_telegram_(p,c){const caption=tzcMc_caption_(p),body={chat_id:c.chat_id};let method='sendMessage';if(p.media_url){method=p.media_type==='image'?'sendPhoto':'sendVideo';body[p.media_type==='image'?'photo':'video']=p.media_url;body.caption=caption}else body.text=caption;const r=tzcMc_http_('https://api.telegram.org/bot'+c.bot_token+'/'+method,'post',body);if(!r.ok||!r.result||!r.result.message_id)throw{mcCode:'TELEGRAM_SEM_CONFIRMACAO',uncertain:true};return{status:'Publicado',id:String(r.result.message_id)}}
