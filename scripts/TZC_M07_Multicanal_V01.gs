function tzcMc_post_(p){const text=v=>String(v||'').trim();const x={title:text(p.title),body:text(p.body),type:text(p.type)||'Conteúdo',media_type:text(p.media_type),media_url:tzcMc_https_(p.media_url||''),link:tzcMc_https_(p.link||''),publish:p.publish===true,networks:[...new Set(p.networks||[])].map(String).sort(),request:text(p.request)};if(!x.title||x.title.length>200||!x.body||x.body.length>12000||!['Conteúdo','Mensagem do dia','Mural de avisos'].includes(x.type)||!/^[-a-z0-9]{20,80}$/i.test(x.request)||x.networks.length>20)throw Error('Confira título, texto e redes selecionadas.');if((x.media_url&&!['image','video'].includes(x.media_type))||(!x.media_url&&x.media_type))throw Error('Informe o tipo e a URL da mídia.');if(!x.publish&&x.networks.length)throw Error('Rascunhos não são enviados às redes.');return x}
