  const hook=[field('webhook_url','URL HTTPS do webhook'),field('webhook_secret','Segredo HMAC de envio (32+ caracteres)'),field('callback_secret','Segredo HMAC de retorno (32+ caracteres)'),field('account_ref','Referência da conta no orquestrador',true)];
