function TZC_MSG_adminUploadImagem(x){TZC_MSG_admin();x=x||{};var mime=String(x.mime||'').toLowerCase(),name=String(x.name||'imagem-mensagem');if(!/^image\/(png|jpeg|webp|gif)$/.test(mime))throw Error('Escolha uma imagem PNG, JPG, WEBP ou GIF.');var raw=String(x.base64||'');if(!raw||raw.length>7000000)throw Error('A imagem deve ter até 5 MB.');var bytes=Utilities.base64Decode(raw),blob=Utilities.newBlob(bytes,mime,name),file=DriveApp.createFile(blob);file.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);var url='https://drive.google.com/uc?export=view&id='+file.getId();TZC_MSG_setGeneralImage_(url);var s=TZC_MSG_ss().getSheetByName(TZC_MSG.CFG);if(s){var a=s.getRange(1,1,s.getLastRow(),2).getDisplayValues();for(var i=1;i<a.length;i++)if(a[i][0]==='imagem_padrao_url')s.getRange(i+1,2).setValue(url)}return{ok:true,url:url,mensagem:'Imagem enviada e vinculada à guia Geral.'}}
function TZC_MSG_adminSalvarConfiguracao(x){TZC_MSG_admin();x=x||{};var send=String(x.horarioEnvio||'08:30'),cut=String(x.horarioLimiteManual||'10:00'),img=String(x.imagemPadraoUrl||'').trim();if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(send)||!/^([01]\d|2[0-3]):[0-5]\d$/.test(cut))throw Error('Informe horários válidos no formato HH:MM.');if(img&&!TZC_MSG_https(img))throw Error('A imagem precisa usar HTTPS.');var channel=String(x.canal||'email').toLowerCase();if(['email','whatsapp'].indexOf(channel)<0)throw Error('Selecione e-mail ou WhatsApp.');var s=TZC_MSG_ss().getSheetByName(TZC_MSG.CFG)||TZC_MSG_ss().insertSheet(TZC_MSG.CFG);if(!s.getLastRow())s.appendRow(['Chave','Valor','Atualizado_Em']);var map={};if(s.getLastRow()>1)s.getRange(2,1,s.getLastRow()-1,2).getDisplayValues().forEach(function(r,i){map[r[0]]=i+2});TZC_MSG_setGeneralImage_(img);[['horario_envio',send],['horario_limite_manual',cut],['imagem_padrao_url',img],['canal',channel],['ativo','Sim']].forEach(function(r){var n=map[r[0]]||s.getLastRow()+1;s.getRange(n,1,1,3).setValues([[r[0],r[1],new Date()]])});ScriptApp.getProjectTriggers().filter(function(t){return t.getHandlerFunction()==='TZC_MSG_processarAgendamento'}).forEach(function(t){ScriptApp.deleteTrigger(t)});ScriptApp.newTrigger('TZC_MSG_processarAgendamento').timeBased().everyMinutes(5).create();return{ok:true,mensagem:'Configuração salva. Verificação automática ativa a cada 5 minutos.'}}
function TZC_MSG_adminSalvarMensagem(x){var email=TZC_MSG_admin();x=x||{};var text=String(x.texto||'').trim(),title=String(x.titulo||'Mensagem do Dia').trim();if(!text)throw Error('Digite a mensagem antes de publicar.');if(text.length>5000)throw Error('A mensagem pode ter até 5.000 caracteres.');var s=TZC_MSG_ss().getSheetByName('Publicacoes');if(!s)throw Error('A aba Publicacoes não existe.');var today=TZC_MSG_date(),img=TZC_MSG_https(x.imagemUrl)||TZC_MSG_cfg().image,rs=TZC_MSG_rows('Publicacoes'),old=rs.find(function(r){return /mensagem/i.test(r.Tipo||'')&&TZC_MSG_key(r.Data_Publicacao||r.Data_Criacao)===TZC_MSG_key(today)}),vals={Titulo:title,Resumo:text.slice(0,300),Conteudo:text,Imagem_URL:img,Data_Publicacao:today,Data_Atualizacao:today,Data_Criacao:today,Tipo:'Mensagem do Dia',Destaque:'Sim',Acesso_Publico:'Sim',Status:'Publicado',Autor:email};if(old){Object.keys(vals).forEach(function(k){TZC_MSG_set(s,old.__row,k,vals[k])})}else{var h=s.getRange(1,1,1,s.getLastColumn()).getDisplayValues()[0];vals.ID_Publicacao='MSG-'+Utilities.getUuid();s.appendRow(h.map(function(k){return vals[String(k).trim()]||''}))}return{ok:true,data:today,mensagem:'Mensagem publicada para hoje.'}}
function TZC_MSG_processarAgendamento(){var c=TZC_MSG_cfg();if(!c.active)return;var today=TZC_MSG_date(),key=TZC_MSG_key(today),n=TZC_MSG_min(),cut=TZC_MSG_toMin(c.cutoff),send=TZC_MSG_toMin(c.send),lock=LockService.getScriptLock();if(!lock.tryLock(15000))return;try{var done=PropertiesService.getScriptProperties().getProperty('TZC_MSG_SENT_'+key);if(done)return;var rs=TZC_MSG_rows('Publicacoes'),m=rs.find(function(r){return /mensagem/i.test(r.Tipo||'')&&TZC_MSG_key(r.Data_Publicacao||r.Data_Criacao)===key});if(!m&&n>=cut){var phrase=TZC_MSG_frase(key);TZC_MSG_publicarAuto(phrase,c.image,today);rs=TZC_MSG_rows('Publicacoes');m=rs.find(function(r){return /mensagem/i.test(r.Tipo||'')&&TZC_MSG_key(r.Data_Publicacao||r.Data_Criacao)===key})}if(!m||(!done&&n<send&&n<cut))return;var body=String(m.Conteudo||m.Resumo||'');if(!body)throw Error('Mensagem de hoje sem texto.');if(c.channel==='whatsapp')return;TZC_MSG_email(m.Titulo||'Mensagem do Dia',body,TZC_MSG_https(m.Imagem_URL||c.image));PropertiesService.getScriptProperties().setProperty('TZC_MSG_SENT_'+key,new Date().toISOString());var s=TZC_MSG_ss().getSheetByName(TZC_MSG.CFG),a=s.getRange(2,1,s.getLastRow()-1,2).getDisplayValues();for(var i=0;i<a.length;i++)if(a[i][0]==='ultima_data_processada')s.getRange(i+2,2,1,2).setValues([[today,new Date()]])}finally{lock.releaseLock()}}
function TZC_MSG_toMin(s){var p=String(s||'00:00').split(':');return +p[0]*60 + +p[1]}
function TZC_MSG_frase(key){var a=['Na Umbanda, a caridade floresce quando oferecemos respeito, escuta e cuidado a quem caminha ao nosso lado. Que hoje cada gesto de bondade ilumine um novo caminho.','Que a fé fortaleça o coração, a humildade oriente nossos passos e a caridade esteja presente nas escolhas deste dia. Saravá a todos os irmãos e irmãs.','A espiritualidade também se revela nas atitudes simples: acolher, respeitar e fazer o bem. Que a luz da Umbanda inspire um dia de paz e bons caminhos.','Cada novo dia é oportunidade de aprender, servir e renovar a esperança. Caminhemos com fé, responsabilidade e amor ao próximo. Saravá!','Que os Orixás abençoem esta jornada com equilíbrio e coragem. A caridade, feita com amor e respeito, transforma quem recebe e quem oferece.'];return a[((key%10000)%100-1+a.length*100)%a.length]}
