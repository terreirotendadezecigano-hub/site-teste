function TZC_MSG_lerDestaques(){var specs=[['Publicacoes','Publicação',['Titulo'],['Resumo','Conteudo'],['Data_Atualizacao','Data_Publicacao','Data_Criacao'],['Acesso_Publico'],['Status'],['Imagem_URL'],'conteudo'],['Eventos','Agenda',['Titulo'],['Descricao'],['Data_Atualizacao','Data_Inicio','Data_Criacao'],['Acesso_Publico'],['Status'],[],'agenda'],['Agenda_Festividades','Agenda',['Nome_Evento','Titulo'],['Descricao'],['Data_Atualizacao','Data_Evento','Data_Criacao'],['Acesso_Publico'],['Status'],['Imagem_URL'],'agenda'],['Ervas_Banhos','Ervas e banhos',['Nome_Erva','Nome_Banho','Titulo'],['Descricao','Propriedades','Modo_Preparo'],['Data_Atualizacao','Data_Criacao'],['Acesso_Publico'],['Status'],['Foto_URL'],'Ervas e banhos'],['Graos_Sementes','Grãos e sementes',['Nome_Grao','Titulo'],['Descricao','Propriedades'],['Data_Atualizacao','Data_Criacao'],['Acesso_Publico'],['Status'],[],'Grãos e sementes'],['Estudo','Estudo',['Titulo'],['Resumo','Texto'],['Data_Atualizacao','Data_Criacao'],['Acesso_Publico'],['Status'],[],'Estudos'],['Pontos_Cantados','Pontos cantados',['Titulo_Ponto','Titulo'],['Letra','Descricao'],['Data_Atualizacao','Data_Criacao'],['Acesso_Publico'],['Status'],[],'Pontos cantados'],['Artes_PDFs','Materiais',['Titulo'],['Descricao'],['Data_Atualizacao','Data_Criacao'],['Acesso_Publico'],['Status'],['Capa_URL'],'Materiais']];var out=[],seen={};specs.forEach(function(sp){TZC_MSG_rows(sp[0]).forEach(function(r){var ac=TZC_MSG_pick(r,sp[5]),st=String(TZC_MSG_pick(r,sp[6])||'').toLowerCase();if(!ac||!/(sim|true|1|publico|público|publica|pública|aberto|aberta)/i.test(ac)||/(inativo|rascunho|cancelado|exclu)/i.test(st))return;var title=TZC_MSG_pick(r,sp[2]),raw=TZC_MSG_pick(r,sp[4]),date=TZC_MSG_fmt(raw),key=TZC_MSG_key(raw);if(!title||!key)return;var identity=sp[0]+'|'+String(r.ID_Publicacao||r.ID_Evento||r.ID_Erva||r.ID_Estudo||r.ID_Material||title)+'|'+date;if((sp[0]==='Eventos'||sp[0]==='Agenda_Festividades')&&(seen['agenda|'+title+'|'+date]))return;if