function TZC_MSG_key(x){var s=String(x||''),m;if((m=s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2,4})/))){var y=+m[3];if(y<100)y+=y<50?2000:1900;return y*10000+(+m[2])*100+(+m[1])}if((m=s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/)))return(+m[1])*10000+(+m[2])*100+(+m[3]);var d=new Date(s);return isNaN(d)?0:+Utilities.formatDate(d,TZC_MSG.TZ,'yyyyMMdd')}
